# ============================================================
# QuickBite Backend Environment Variables (Production & Staging)
# ============================================================

# Network & Port Configuration (Render sets PORT automatically)
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Database Connection
# In Production: Use your MongoDB Atlas connection string (Cluster -> Connect -> Drivers)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/quickbite?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/quickbite?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string in production, min 32 characters)
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters

# Allowed Frontend URL(s) for CORS (Comma-separated if multiple, no trailing slash)
# Example: https://quickbite-app.onrender.com,https://quickbite.srmist.edu.in
CLIENT_URL=https://your-frontend-app.onrender.com

# Initial Database Seeding
# Set to 'false' if you want a clean database with no initial demo items
SEED_DATABASE=true
