# ============================================================
# QuickBite Frontend Environment Variables (Production & Staging)
# ============================================================

# Full URL of your deployed Backend REST API on Render (no trailing slash)
# Example: https://quickbite-backend-api.onrender.com
# Leave empty or omit during local development to use the Vite localhost:5000 proxy
VITE_API_BASE_URL=https://your-backend-api.onrender.com
